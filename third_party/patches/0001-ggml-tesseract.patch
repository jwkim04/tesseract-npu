diff --git a/ggml/src/ggml-tesseract/CMakeLists.txt b/ggml/src/ggml-tesseract/CMakeLists.txt
new file mode 100644
index 000000000..96ac4aa9f
--- /dev/null
+++ b/ggml/src/ggml-tesseract/CMakeLists.txt
@@ -0,0 +1,30 @@
+# ggml-tesseract: forwarding stub for the Tesseract FPGA overlay backend.
+#
+# The backend sources live in the Tesseract repository (${TESSERACT_ROOT}/sw/ggml-tesseract);
+# this directory only exists so that ggml_add_backend(Tesseract) can build them as a regular
+# ggml backend library. The Tesseract top-level CMakeLists sets TESSERACT_ROOT and defines the
+# tsr_ref and tsr_transport targets before adding llama.cpp.
+
+if (NOT TESSERACT_ROOT)
+    message(FATAL_ERROR "GGML_TESSERACT requires TESSERACT_ROOT (the Tesseract repository); "
+                        "configure llama.cpp through the Tesseract top-level CMakeLists.txt")
+endif()
+
+foreach (tsr_target tsr_ref tsr_transport)
+    if (NOT TARGET ${tsr_target})
+        message(FATAL_ERROR "GGML_TESSERACT: target ${tsr_target} is not defined; it must be added "
+                            "before llama.cpp (Tesseract top-level CMakeLists.txt)")
+    endif()
+endforeach()
+
+# defines GGML_TESSERACT_SOURCES and GGML_TESSERACT_INCLUDE_DIRS
+include(${TESSERACT_ROOT}/sw/ggml-tesseract/sources.cmake)
+
+ggml_add_backend_library(ggml-tesseract ${GGML_TESSERACT_SOURCES})
+
+target_include_directories(ggml-tesseract PRIVATE ${GGML_TESSERACT_INCLUDE_DIRS})
+target_link_libraries(ggml-tesseract PRIVATE tsr_ref tsr_transport)
+target_compile_features(ggml-tesseract PRIVATE cxx_std_17)
+if (TSR_FP_FLAGS)
+    target_compile_options(ggml-tesseract PRIVATE ${TSR_FP_FLAGS})
+endif()
