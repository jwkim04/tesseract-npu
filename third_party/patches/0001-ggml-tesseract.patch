diff --git a/ggml/include/ggml-tesseract.h b/ggml/include/ggml-tesseract.h
new file mode 100644
index 000000000..01a36c40c
--- /dev/null
+++ b/ggml/include/ggml-tesseract.h
@@ -0,0 +1,30 @@
+#pragma once
+
+// Tesseract FPGA overlay core backend.
+// The implementation lives outside ggml, in the Tesseract repository (sw/ggml-tesseract);
+// ggml/src/ggml-tesseract only forwards to it. See docs/spec.md there ("ggml 백엔드 통합").
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#ifdef  __cplusplus
+extern "C" {
+#endif
+
+#define GGML_TESSERACT_NAME "Tesseract"
+
+// backend registration: one device "Tesseract0" (GGML_BACKEND_DEVICE_TYPE_GPU),
+// none if TSR_DEVICE=none
+GGML_BACKEND_API ggml_backend_reg_t ggml_backend_tesseract_reg(void);
+
+// convenience: backend of device 0, or NULL if there is no device / the transport fails to open
+GGML_BACKEND_API ggml_backend_t ggml_backend_tesseract_init(void);
+
+GGML_BACKEND_API bool ggml_backend_is_tesseract(ggml_backend_t backend);
+
+// the device's (only) buffer type
+GGML_BACKEND_API ggml_backend_buffer_type_t ggml_backend_tesseract_buffer_type(void);
+
+#ifdef  __cplusplus
+}
+#endif
