+/*
+ * Linux 6.11 changed platform_driver::remove() to return void (commit
+ * 0edb555a65d1). The subdev remove routines keep returning int; use
+ * ".remove = XOCL_PLATFORM_REMOVE(fn)" with XOCL_DEFINE_PLATFORM_REMOVE(fn)
+ * placed after fn. Before 6.11 this is fn itself. From 6.11 it is a void
+ * wrapper that prints the warning the platform core printed for a
+ * non-zero return value on the older kernels (drivers/base/platform.c).
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 11, 0)
+#define XOCL_DEFINE_PLATFORM_REMOVE(fn)					\
+static void fn##_void(struct platform_device *pdev)			\
+{									\
+	if (fn(pdev))							\
+		dev_warn(&pdev->dev, "remove callback returned a non-zero value. This will be ignored.\n"); \
+}
+#define XOCL_PLATFORM_REMOVE(fn)	fn##_void
+#else
+#define XOCL_DEFINE_PLATFORM_REMOVE(fn)
+#define XOCL_PLATFORM_REMOVE(fn)	fn
+#endif
+
