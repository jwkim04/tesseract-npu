#!/bin/sh
# tsr-top: the live monitor of the Tesseract card (docs/prof-dbg.md §7). Generated by CMake from
# sw/tools/top/tsr-top.in; it runs sw/tools/top/tsr_top.py with the Python of the build and finds
# tsr-mon-probe next to itself. Python standard library only.
TSR_TOP_BIN_DIR="${TSR_TOP_BIN_DIR:-@CMAKE_BINARY_DIR@/bin}"
export TSR_TOP_BIN_DIR
exec "@TSR_TOP_PYTHON@" "@CMAKE_CURRENT_LIST_DIR@/tsr_top.py" "$@"
