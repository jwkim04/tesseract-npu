/build/*
/models/
__pycache__/
*.pyc
/traces/tmp/
sim_build/
results.xml
# Large regenerable trace sets: keep only their generator scripts in git
# (each regen.sh reproduces its set byte for byte). traces/model is a recorded set kept on disk;
# this tree cannot regenerate it.
/traces/m3/*
!/traces/m3/regen.sh
/traces/model/*
/traces/model-v1conv/*
!/traces/model-v1conv/regen.sh
/traces/m2/*
!/traces/m2/regen.sh
/traces/gen/*
!/traces/gen/regen.sh
/traces/vu/*
!/traces/vu/regen.sh
/traces/at/*
!/traces/at/regen.sh
/traces/ctrl/*
!/traces/ctrl/regen.sh

# Logo previews written by docs/logo/src/render_final.py (not assets)
/docs/logo/sheet.png
/docs/logo/src/check/

# Local editor and agent settings
/.claude/
