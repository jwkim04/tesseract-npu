/build/*
/models/
__pycache__/
*.pyc
/traces/tmp/
sim_build/
results.xml
# Large regenerable trace sets: keep only their generator scripts in git
# (traces/m3/regen.sh and traces/model/regen.sh reproduce them byte for byte).
/traces/m3/*
!/traces/m3/regen.sh
!/traces/m3/trace_stats.py
/traces/model/*
!/traces/model/regen.sh
/traces/model-v1conv/*
!/traces/model-v1conv/regen.sh
/traces/m2/*
!/traces/m2/regen.sh
/traces/gen/*
!/traces/gen/regen.sh
/traces/vu/*
!/traces/vu/regen.sh
/traces/at/*
!/traces/at/regen.sh
/traces/ctrl/*
!/traces/ctrl/regen.sh

